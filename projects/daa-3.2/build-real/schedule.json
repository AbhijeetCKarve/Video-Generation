   "dur": 8.78,
   "end": 67.205,
   "section": null,
   "music": null,
   "phrases": [
    {
     "text": "That is why backtracking is so much faster than trying everything.",
     "start": 57.876,
     "end": 62.526
    },
    {
     "text": "Whole branches of the search tree are cut away early.",
     "start": 62.526,
     "end": 66.656
    }
   ]
  },
  {
   "key": "q_rules",
   "num": "09",
   "mood": "explain",
