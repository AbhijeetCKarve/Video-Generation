   "section": null,
   "music": null,
   "phrases": [
    {
     "text": "This is graph coloring.",
     "start": 262.632,
     "end": 264.192
    },
    {
     "text": "Give every vertex one of m colors, so that no two adjacent vertices get the same color.",
