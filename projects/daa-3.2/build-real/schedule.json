   "section": "The algorithm",
   "music": "quiet",
   "phrases": [
    {
     "text": "Here is the algorithm.",
     "start": 217.599,
     "end": 219.845
    },
    {
     "text": "N Queens of k tries every column i for row k.",
     "start": 219.845,
     "end": 224.44
    }
   ]
  },
  {
   "key": "a_code2",
   "num": "28",
   "mood": "explain",
   "start": 224.99,
   "voice": "/home/user/Video-Generation/projects/daa-3.2/voice-real/28.wav",
   "dur": 12.464,
   "end": 238.004,
   "section": null,
   "music": null,
   "phrases": [
    {
     "text": "If Place says it is safe, we set x of k to i.",
     "start": 224.99,
     "end": 228.62
    },
    {
     "text": "If k equals n, we print the solution, otherwise we move on to row k plus one.",
     "start": 228.62,
     "end": 237.454
    }
   ]
  },
  {
   "key": "a_complex",
   "num": "29",
   "mood": "explain",
   "start": 238.004,
   "voice": "/home/user/Video-Generation/projects/daa-3.2/voice-real/29.wav",
   "dur": 7.815,
   "end": 246.368,
   "section": null,
   "music": null,
   "phrases": [
    {
     "text": "In the worst case the tree has about n factorial leaves,",
     "start": 238.004,
     "end": 242.253
    },
    {
     "text": "so the time complexity is order of n factorial.",
     "start": 242.253,
     "end": 245.819
    }
   ]
  },
