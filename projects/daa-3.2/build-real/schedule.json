   "end": 57.876,
   "section": null,
   "music": null,
   "phrases": [
    {
     "text": "After every choice, we check a bounding function.",
     "start": 48.054,
     "end": 52.304
    },
    {
     "text": "If the partial answer can never become a solution, we stop and go back.",
     "start": 52.304,
     "end": 57.325
    }
   ]
  },
  {
   "key": "recap3",
   "num": "08",
   "mood": "warm",
